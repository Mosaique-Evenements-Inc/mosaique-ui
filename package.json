{
  "name": "@mosaique-evenements-inc/ui",
  "version": "0.2.0",
  "description": "Shared visual foundation for Mosaïque frontend applications",
  "private": false,
  "files": [
    "src"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./foundation.css": "./src/foundation.css",
    "./recipes.css": "./src/recipes.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check": "pnpm run format:check && pnpm run package:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:check": "node scripts/validate-package.mjs"
  },
  "keywords": [
    "mosaique",
    "design-tokens",
    "ui"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mosaique-Evenements-Inc/mosaique-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
